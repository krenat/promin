# Скопіюйте у .env і заповніть. Файл .env у git не потрапляє.

# Довгий випадковий токен для входу, наприклад: openssl rand -hex 32
PROMIN_TOKEN=

# Порт, на якому слухає сервіс
PROMIN_PORT=8080

# Тека з даними (оригінали, готові відео, мініатюри, список)
PROMIN_DATA_DIR=./data

# Ліміт розміру одного завантаження, МБ
PROMIN_MAX_UPLOAD_MB=4096

# Стеля бітрейту готового відео, кбіт/с
PROMIN_MAX_BITRATE_KBPS=8000
