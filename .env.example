# Copy to .env and fill in. The .env file never goes into git.

# Password of the built-in administrator (login "admin"), at least 12 characters.
# Sessions depend on it too: changing the value logs everyone out.
# Generate one: LC_ALL=C tr -dc a-z0-9 </dev/urandom | head -c 16
PROMIN_TOKEN=

# Port the service listens on (in Docker: both inside the container and outside)
PROMIN_PORT=8080

# Data directory (originals, finished videos, thumbnails, the list).
# Not used in Docker: data lives in the promin-data volume.
PROMIN_DATA_DIR=./data

# Size limit for a single upload, MB
PROMIN_MAX_UPLOAD_MB=4096

# The two values below are only defaults: once encoding is saved on the /settings page,
# the saved values are used instead.

# Bitrate ceiling for the finished video, kbit/s
PROMIN_MAX_BITRATE_KBPS=8000

# x264 preset: faster ones (superfast, ultrafast) load the CPU less,
# slower ones (fast, medium) give better quality at the same bitrate
PROMIN_X264_PRESET=veryfast

# How many CPU cores the container may use (Docker only)
PROMIN_CPUS=2

# Only behind a reverse proxy (Caddy, nginx) that adds HTTPS: the addresses the proxy
# connects from, comma-separated, or * if nothing else can reach the port. The service then
# sees the visitor's own address (the login limit counts attempts per address) and marks
# its cookies Secure. Leave unset when the port is open directly.
# FORWARDED_ALLOW_IPS=
