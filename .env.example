# Скопіюйте у .env і заповніть. Файл .env у git не потрапляє.

# Токен для входу, щонайменше 12 символів. Його доведеться раз набрати пультом
# на проекторі, тому зручні малі літери й цифри, наприклад:
#   LC_ALL=C tr -dc a-z0-9 </dev/urandom | head -c 16
PROMIN_TOKEN=

# Порт, на якому слухає сервіс (у Docker — і всередині контейнера, і назовні)
PROMIN_PORT=8080

# Тека з даними (оригінали, готові відео, мініатюри, список).
# У Docker не використовується: дані лежать у томі promin-data.
PROMIN_DATA_DIR=./data

# Ліміт розміру одного завантаження, МБ
PROMIN_MAX_UPLOAD_MB=4096

# Стеля бітрейту готового відео, кбіт/с
PROMIN_MAX_BITRATE_KBPS=8000

# Пресет x264: швидші (superfast, ultrafast) менше вантажать процесор,
# повільніші (fast, medium) дають кращу якість за того самого бітрейту
PROMIN_X264_PRESET=veryfast

# Скільки ядер процесора дозволено контейнеру (лише для Docker)
PROMIN_CPUS=2
